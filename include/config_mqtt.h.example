#pragma once

// ============================================================
//  MQTT-Konfiguration
//  Diese Datei einmal nach "config_mqtt.h" kopieren und ausfüllen.
//  Sie bleibt bei Code-Updates unangetastet.
// ============================================================

// Broker-Verbindung (ioBroker mqtt-Adapter oder Mosquitto)
#define MQTT_SERVER     "192.168.1.100"
#define MQTT_PORT       1883
#define MQTT_USER       ""          // leer lassen, wenn der Broker keine Auth verlangt
#define MQTT_PASSWORD   ""

// Basis-Pfad für die Govee-Sensoren, z. B. govee/H5075_1A2B/temperature
// LEER SETZEN (""), um die Govee-Überwachung komplett zu deaktivieren
// (dann entfallen auch die Topics govee/status und govee/version).
#define MQTT_BASETOPIC  "govee"

// Qingping-Geräte erscheinen unter eigenem Pfad,
// z. B. qingping/Qingping_50C8/temperature|humidity|co2|pm25|pm10|rssi
// LEER SETZEN (""), um den Qingping-Bereich zu deaktivieren.
#define MQTT_TOPIC_QINGPING "qingping"

// Oclean-Zahnbürsten erscheinen unter eigenem Pfad,
// z. B. oclean/Oclean_X_9672/adv_pro_min|rssi
// LEER SETZEN (""), um den Oclean-Bereich zu deaktivieren.
#define MQTT_TOPIC_OCLEAN  "oclean"

// Werte mit Retain-Flag publishen (der Broker cacht den letzten Wert)
#define MQTT_RETAIN     true

// Mindestabstand zwischen zwei Publishes pro Gerät in Sekunden
// (der H5075 sendet ~2x/s; nur Änderungen werden gemeldet)
#define MIN_PUBLISH_INTERVAL_S  10

// ---- Zahnbürsten-Beobachtung (Oclean) ----
// Zählt BLE-Frames von 'Oclean'-Geräten, Xiaomi-0xFEAF-Frames und
// dem Oclean-MAC-Präfix. Je Bürste ein eigener Ordner (Modellname +
// letzte 4 MAC-Stellen):
//   oclean/adv_pro_min              Summe aller Bürsten
//   oclean/Oclean_X_9672/adv_pro_min  je Bürste (nur bei Änderung)
//   oclean/Oclean_X_9672/rssi
// Messung 10/2026: Die Bürsten senden im Standby ~11-22 Frames/min mit
// eingefrorener Payload und ändern weder Payload noch Rate, wenn der
// Motor läuft - ein "wird benutzt"-Signal ist per passivem BLE-Mithören
// nicht vorhanden (daher gibt es bewusst kein 'aktiv'-Topic).
#define BRUSH_WINDOW_S          60  // Zählfenster in Sekunden
