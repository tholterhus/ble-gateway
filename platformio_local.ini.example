; ============================================================
;  Vorlage: Diese Datei nach "platformio_local.ini" kopieren und
;  das OTA-Passwort eintragen. Die Datei ist via .gitignore vom
;  Repo ausgeschlossen.
;
;  Achtung: Muss mit OTA_PASSWORD in include/config.h
;  übereinstimmen - das Passwort der LAUFENDEN Firmware entscheidet
;  beim OTA-Upload, eine Änderung wird erst mit dem nächsten
;  erfolgreichen Upload aktiv.
; ============================================================
[env:esp32c3_supermini]
upload_flags = --auth=DEIN_OTA_PASSWORT
